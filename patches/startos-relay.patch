+fn artifact_revision(
+    author: &Keys,
+    artifact: &str,
+    channel: &str,
+    op: &str,
+    kind_type: &str,
+    prev: Option<&EventId>,
+) -> nostr::Event {
+    let mut tags = vec![
+        tag(&["ar", "1"]),
+        tag(&["d", artifact]),
+        tag(&["h", channel]),
+        tag(&["type", kind_type]),
+        tag(&["op", op]),
+    ];
+    if op != "delete" {
+        tags.push(tag(&["title", "Task"]));
+    }
+    tags.extend(prev.map(|p| tag(&["prev", &p.to_hex()])));
+    sign(author, 45010, "", tags)
+}
+
+fn d_tag(event: &nostr::Event) -> String {
+    event
+        .tags
+        .iter()
+        .find_map(|t| {
+            let s = t.as_slice();
+            (s.first().map(String::as_str) == Some("d")).then(|| s[1].clone())
+        })
+        .expect("d tag")
+}
